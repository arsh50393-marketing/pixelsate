# Copy this file to ".env.local" and fill in real values.
# These power the contact-form email (app/api/lead/route.ts).

# 1) Get a free API key at https://resend.com  (Dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 2) Where lead emails should land. Comma-separate for multiple recipients.
LEAD_TO_EMAIL=you@yourbusiness.com

# 3) The "from" address.
#    - For quick testing you can use Resend's shared sender:
#        LEAD_FROM_EMAIL=Pixelsate Leads <onboarding@resend.dev>
#      (with the shared sender, Resend only delivers to YOUR own account email)
#    - For production, verify your domain in Resend and use your own address:
#        LEAD_FROM_EMAIL=Pixelsate <leads@yourbusiness.com>
LEAD_FROM_EMAIL=Pixelsate Leads <onboarding@resend.dev>
